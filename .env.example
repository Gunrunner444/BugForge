# Environment configuration for BugForge
# Copy this to .env and fill in your values

# Database
POSTGRES_PASSWORD=bugforge_dev
DATABASE_URL=postgresql+asyncpg://bugforge:bugforge_dev@localhost:5432/bugforge

# Security — change this in production
SECRET_KEY=change_me_in_production_please

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# CORS — frontend origin(s)
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# GitHub Integration (Phase 9)
# Set to a GitHub personal access token or GitHub App token with repo scope.
# Never commit a real token. This is used for server-side GitHub operations only.
# The token is NEVER stored in the database or sent to AI providers.
# GITHUB_TOKEN=ghp_your_token_here
