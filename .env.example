# Environment configuration for BugForge v1.1.0
# Copy this to .env and fill in your values

# Database
POSTGRES_PASSWORD=bugforge_dev
DATABASE_URL=postgresql+asyncpg://bugforge:bugforge_dev@localhost:5432/bugforge

# Security — change this in production
SECRET_KEY=change_me_in_production_please

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# CORS — frontend origin(s)
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# AI Provider (v1.1.0)
# ---------------------------------------------------------------------------
# Supported providers: mock | openai | anthropic | ollama | openai_compatible | local
#
# Local AI with Ollama:
#   1. Install Ollama: https://ollama.com
#   2. Pull a model:   ollama pull qwen2.5-coder:7b
#   3. Start Ollama:   ollama serve
#   4. Set these vars and restart BugForge:
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
# For Ollama:       AI_BASE_URL=http://localhost:11434/v1
# For LM Studio:   AI_BASE_URL=http://localhost:1234/v1
# For OpenAI:      leave AI_BASE_URL empty
# For generic local OpenAI-compatible: AI_PROVIDER=local
AI_BASE_URL=
# API key — required for OpenAI/Anthropic; leave empty for Ollama/mock
AI_API_KEY=
AI_TEMPERATURE=0.1
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# Language analyzers that run during static analysis.
# Empty = every registered adapter that implements static analysis (currently python).
# LANGUAGE_ANALYZERS=python

# ---------------------------------------------------------------------------
# GitHub Integration (v0.9+)
# ---------------------------------------------------------------------------
# Set to a GitHub personal access token with repo scope for:
#   - autonomous discovery (public repo search, no token still works but is rate-limited)
#   - verified patch delivery via PR
# Never commit a real token. Never stored in database. Never sent to AI.
# GITHUB_TOKEN=ghp_your_token_here

# ---------------------------------------------------------------------------
# Autonomous Discovery (v1.1.0)
# ---------------------------------------------------------------------------
# master switch: disabled | manual | scheduled
DISCOVERY_MODE=disabled

# Scheduled discovery interval (hours)
DISCOVERY_INTERVAL_HOURS=24

# Repository filter criteria
DISCOVERY_MIN_STARS=1000
DISCOVERY_MAX_STARS=0
DISCOVERY_MAX_SIZE_KB=50000
DISCOVERY_LANGUAGES=Python,JavaScript,TypeScript,Go,Rust,Java
DISCOVERY_REQUIRE_LICENSE=true
DISCOVERY_SKIP_FORKS=true
DISCOVERY_SKIP_ARCHIVED=true
DISCOVERY_MAX_STALENESS_DAYS=365
DISCOVERY_EXCLUDED_TOPICS=exploit,hack,malware,pentest,ctf
DISCOVERY_EXCLUDED_OWNERS=

# Rate / resource limits
DISCOVERY_DAILY_REPO_LIMIT=100
DISCOVERY_MAX_CONCURRENT=2
DISCOVERY_DAILY_AI_LIMIT=200

# ---------------------------------------------------------------------------
# Safety Policy (v1.1.0)
# ---------------------------------------------------------------------------
# Hard limits — repositories violating these are blocked before analysis
SAFETY_MAX_REPO_SIZE_KB=100000
SAFETY_MAX_FILE_COUNT=20000
SAFETY_MAX_SCRIPT_COUNT=50

# Execution policy — what is permitted inside the Docker sandbox
SAFETY_ALLOW_DOCKER_EXEC=true
SAFETY_ALLOW_SANDBOX_NETWORK=false
SAFETY_ALLOW_DEP_INSTALL=false

