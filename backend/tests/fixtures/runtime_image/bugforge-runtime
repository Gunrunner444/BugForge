#!/usr/bin/env python3
"""bugforge-runtime-v1 contract fixture. Echoes the request identity; executes nothing."""

import argparse
import json

parser = argparse.ArgumentParser()
parser.add_argument("--input", required=True)
parser.add_argument("--output", required=True)
args = parser.parse_args()
with open(args.input, encoding="utf-8") as handle:
    manifest = json.load(handle)
contract = manifest.get("contract") or "Vault"
address = manifest.get("deployment_address") or "0x1"
document = {
    "schema": "bugforge-runtime-v1",
    "request_identity": manifest["request_identity"],
    "execution_id": manifest["execution_id"],
    "mode": manifest["mode"],
    "target": manifest["target"],
    "project": manifest["project"],
    "source_snapshot": manifest["source_snapshot"],
    "compiler_configuration": manifest["compiler_configuration"],
    "runtime_environment": "contract-fixture",
    "runtime_configuration": manifest["runtime_configuration"],
    "chain_id": manifest["chain_id"] or "31337",
    "block_number": manifest["block_number"] or "1",
    "block_timestamp": "0",
    "state_snapshot": manifest["state_snapshot"] or "genesis",
    "tool": "bugforge-runtime-contract-fixture",
    "tool_version": "bugforge-runtime-v1",
    "duration": "0",
    "sequence_id": manifest["sequence_id"],
    "deployments": [{"address": address, "contract": contract, "identity": contract}],
    "transactions": [
        {
            "index": manifest["transaction_index"],
            "sequence_id": manifest["sequence_id"],
            "actor": manifest["actor"],
            "contract": contract,
            "address": address,
            "function_identity": manifest["function_identity"],
            "identity_established": bool(manifest["function_identity"]),
            "success": True,
            "return_data": "0x",
            "gas_used": "0",
            "call_type": "CALL",
        }
    ],
}
with open(args.output, "w", encoding="utf-8") as handle:
    json.dump(document, handle)
